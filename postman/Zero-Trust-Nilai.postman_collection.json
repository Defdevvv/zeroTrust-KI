  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "62b6ed23-e2bb-4c4f-9d04-3f0a61a7c49f",
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "const tokenKeys = {",
          "  'Nilai mahasiswa sendiri': 'mhs1_access_token', 'Mahasiswa membaca NIM lain': 'mhs1_access_token',",
          "  'Nilai dosen1': 'dosen_access_token', 'Dosen membaca kelas dosen2': 'dosen_access_token',",
          "  'Dosen2 mengubah nilai dosen1': 'dosen2_access_token', 'Dosen mengubah nilai': 'dosen_access_token',",
          "  'Nilai di luar rentang': 'dosen_access_token', 'Device tidak terdaftar': 'mhs1_access_token',",
          "  'Device hilang': 'mhs1_access_token', 'Endpoint tidak dikenal': 'mhs1_access_token',",
          "  'Secret client ditimpa gateway': 'mhs1_access_token', 'Token user ke endpoint sinkron': 'dosen_access_token',",
          "  'Finalisasi kelas': 'dosen_access_token', 'Finalisasi ulang idempotent': 'dosen_access_token',",
          "  'Transkrip mahasiswa sendiri': 'mhs1_access_token', 'Transkrip mahasiswa lain': 'mhs1_access_token',",
          "  'Admin membaca nilai': 'admin_access_token', 'Admin membaca transkrip': 'admin_access_token',",
          "  'Akses langsung Service Nilai': 'mhs1_access_token', 'Akses langsung Service Transkrip': 'mhs1_access_token'",
          "};",
          "const loginPasswords = {",
          "  'Login dosen1': 'dosen1_password', 'Login mahasiswa mhs1': 'mhs1_password',",
          "  'Login mahasiswa mhs2': 'mhs2_password', 'Login dosen2': 'dosen2_password',",
          "  'Login admin': 'admin_password', 'Login device salah': 'dosen1_password'",
          "};",
          "if (name === 'Login dosen1') {",
          "  ['dosen_access_token', 'mhs1_access_token', 'mhs2_access_token', 'dosen2_access_token', 'admin_access_token', 'service_access_token', 'dosen_refresh_token', 'nilai_id', 'sync_id'].forEach((key) => pm.collectionVariables.set(key, ''));",
          "}",
          "const stopRequest = (message) => {",
          "  console.error(message);",
          "  throw new Error(message);",
          "};",
          "if (loginPasswords[name] && !String(pm.environment.get(loginPasswords[name]) || '').trim()) {",
          "  stopRequest(`Environment ${loginPasswords[name]} masih kosong. Isi password seed dari README pada Current Value environment Postman.`);",
          "}",
          "if (tokenKeys[name] && !String(pm.collectionVariables.get(tokenKeys[name]) || '').trim()) {",
          "  stopRequest(`Token ${tokenKeys[name]} belum tersedia. Pastikan request login terkait berhasil dan password environment sudah diisi.`);",
          "}",
          "if ((name === 'Token service valid' || name === 'Secret benar tanpa token' || name === 'Secret benar dengan token invalid') && !String(pm.environment.get(name === 'Token service valid' ? 'service_client_secret' : 'gateway_secret') || '').trim()) {",
          "  const key = name === 'Token service valid' ? 'service_client_secret' : 'gateway_secret';",
          "  stopRequest(`Environment ${key} masih kosong. Isi Current Value dari .env lokal.`);",
          "}",
          "const statuses = {",
          "  'Login dosen1': 200, 'Login mahasiswa mhs1': 200, 'Login mahasiswa mhs2': 200,",
          "  'Login dosen2': 200, 'Login admin': 200, 'Login password salah': 401,",
          "  'Login device salah': 403, 'Refresh token dosen': 200, 'Logout dosen': 200,",
          "  'Nilai tanpa token': 401, 'Nilai mahasiswa sendiri': 200,",
          "  'Mahasiswa membaca NIM lain': 403, 'Nilai dosen1': 200,",
          "  'Dosen membaca kelas dosen2': 403, 'Admin membaca nilai': 403,",
          "  'Dosen2 mengubah nilai dosen1': 403, 'Dosen mengubah nilai': null,",
          "  'Nilai di luar rentang': null, 'Device tidak terdaftar': 403,",
          "  'Device hilang': 403, 'Endpoint tidak dikenal': 403,",
          "  'Secret client ditimpa gateway': 200, 'Token service valid': 200,",
          "  'Token service salah': 401, 'Token user ke endpoint sinkron': 403,",
          "  'Finalisasi kelas': null, 'Finalisasi ulang idempotent': null,",
          "  'Transkrip mahasiswa sendiri': 200, 'Transkrip mahasiswa lain': 403,",
          "  'Admin membaca transkrip': 200, 'Akses langsung Service Nilai': 403,",
          "  'Akses langsung Service Transkrip': 403, 'Secret benar tanpa token': 401,",
          "  'Secret benar dengan token invalid': 401",
          "};",
          "let expected = statuses[name] === undefined ? 200 : statuses[name];",
          "if (name === 'Dosen mengubah nilai' || name === 'Nilai di luar rentang' || name.startsWith('Finalisasi')) {",
          "  const wib = new Date(Date.now() + 7 * 60 * 60 * 1000);",
          "  const minute = wib.getUTCHours() * 60 + wib.getUTCMinutes();",
          "  const open = minute >= 420 && minute < 1260;",
          "  expected = name === 'Nilai di luar rentang' ? (open ? 400 : 403) : (open ? 200 : 403);",
          "}",
          "pm.variables.set('expected_status', expected);",
          "const errors = {",
          "  'Login password salah': 'Kredensial atau device tidak valid',",
          "  'Login device salah': 'Kredensial atau device tidak valid',",
          "  'Token user ke endpoint sinkron': 'hanya token service',",
          "  'Akses langsung Service Nilai': 'X-Gateway-Secret',",
          "  'Akses langsung Service Transkrip': 'X-Gateway-Secret'",
          "};",
          "pm.variables.set('expected_error', errors[name] || '');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "id": "3ad30cae-ad86-429e-8cce-b003cb323805",
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "const body = pm.response.json();",
          "pm.test(`HTTP ${pm.variables.get('expected_status')}`, () => pm.response.to.have.status(Number(pm.variables.get('expected_status'))));",
          "pm.test('Response berupa JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "const expectedError = pm.variables.get('expected_error');",
          "if (expectedError) pm.test('Alasan penolakan sesuai', () => pm.expect(body.error).to.include(expectedError));",
          "const tokenKeys = {",
          "  'Login dosen1': 'dosen', 'Login mahasiswa mhs1': 'mhs1',",
          "  'Login mahasiswa mhs2': 'mhs2', 'Login dosen2': 'dosen2', 'Login admin': 'admin'",
          "};",
          "if (tokenKeys[name] && pm.response.code === 200) {",
          "  const role = tokenKeys[name];",
          "  pm.collectionVariables.set(`${role}_access_token`, body.access_token);",
          "  if (body.refresh_token) pm.collectionVariables.set(`${role}_refresh_token`, body.refresh_token);",
          "  pm.test('Access token dan refresh token diterbitkan', () => {",
          "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
          "    pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
          "  });",
          "}",
          "if (name === 'Refresh token dosen' && pm.response.code === 200) {",
          "  pm.collectionVariables.set('dosen_access_token', body.access_token);",
          "  pm.collectionVariables.set('dosen_refresh_token', body.refresh_token);",
          "}",
          "if (name === 'Token service valid' && pm.response.code === 200) {",
          "  pm.collectionVariables.set('service_access_token', body.access_token);",
          "  pm.test('Token service berlaku lima menit', () => pm.expect(body.expires_in).to.eql(300));",
          "}",
          "if (name === 'Nilai dosen1' && pm.response.code === 200 && body.data.length) {",
          "  pm.collectionVariables.set('nilai_id', body.data[0].id);",
          "  pm.test('Dosen hanya menerima kelas yang diampu', () => pm.expect(body.data.every((row) => row.kelas_id === 1)).to.eql(true));",
          "}",
          "if (name === 'Nilai mahasiswa sendiri' && pm.response.code === 200) {",
          "  pm.test('Nilai hanya milik mahasiswa login', () => pm.expect(body.data.every((row) => row.nim === '227006001')).to.eql(true));",
          "}",
          "if (name === 'Finalisasi kelas' && pm.response.code === 200) {",
          "  pm.collectionVariables.set('sync_id', body.sync_id);",
          "  pm.test('Finalisasi dan sinkronisasi berhasil', () => pm.expect(body.status).to.eql('succeeded'));",
          "}",
          "if (name === 'Finalisasi ulang idempotent' && pm.response.code === 200) {",
          "  pm.test('Retry memakai idempotency key yang sama', () => pm.expect(body.sync_id).to.eql(pm.collectionVariables.get('sync_id')));",
          "}",
          "if (name === 'Transkrip mahasiswa sendiri' && pm.response.code === 200) {",
          "  pm.test('Response memuat daftar transkrip', () => pm.expect(body.transkrip).to.be.an('array'));",
          "}"
        ]
      }
    }
